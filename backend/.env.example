# Copy to .env and adjust. docker-compose reads these automatically.

# Database
DB_URL=jdbc:postgresql://localhost:5432/worknear
DB_USERNAME=worknear
DB_PASSWORD=worknear

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Server
SERVER_PORT=8080

# JWT (CHANGE IN PRODUCTION - must be at least 32 chars)
JWT_SECRET=change-me-in-prod-this-is-a-dev-only-secret-key-please-rotate-1234567890
JWT_ACCESS_TTL=60
JWT_REFRESH_TTL=30

# Integration stubs (set to false + provide real keys later)
OTP_MOCK=true
PAYMENT_MOCK=true
STORAGE_MOCK=true
PUSH_MOCK=true

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081
