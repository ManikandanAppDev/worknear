# Copy to .env.prod on your AWS Lightsail / VPS. NEVER commit .env.prod.

# ---- Profile ----
SPRING_PROFILES_ACTIVE=prod

# ---- Database (used by postgres container + API) ----
DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD_32_CHARS_MIN

# ---- Redis (internal Docker network only) ----
REDIS_HOST=redis
REDIS_PORT=6379

# ---- JWT (must be unique per environment; 32+ random chars) ----
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_ACCESS_TTL=60
JWT_REFRESH_TTL=30

# ---- Integrations (false when you wire real providers) ----
OTP_MOCK=true
PAYMENT_MOCK=true
STORAGE_MOCK=true
PUSH_MOCK=true

# ---- Public URLs ----
# Your public API domain (HTTPS). Used for uploaded file URLs.
STORAGE_BASE_URL=https://dev-api.yourdomain.com/files

# Admin web origin only (Android native app does not use CORS).
CORS_ORIGINS=https://admin.yourdomain.com
